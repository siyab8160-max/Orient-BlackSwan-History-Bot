# ==============================================================================
# Orient BlackSwan History Catalogue RAG Bot - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Source Document Configuration
PDF_URL=https://www.orientblackswan.com/pdfs/downloads/History_2024-25.pdf
PDF_LOCAL_PATH=data/History_2024-25.pdf

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=obs_history_catalogue

# Model Settings (Supported stable model: gemini-embedding-2 & gemini-3.5-flash-lite)
EMBEDDING_MODEL=gemini-embedding-2
LLM_MODEL=gemini-3.5-flash-lite

# Application Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
